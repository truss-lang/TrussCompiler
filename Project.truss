let project = Project(
    name: "TrussCompiler",
    version: "0.1.0",
    targets: [
        Target(name: "TrussSyntax"),
        Target(name: "TrussCompiler", dependencies: ["TrussSyntax",]),
        Target(name: "TrussPackageManager")
    ],
    products: [
        Product(name: "trussc", type: .Executable, targets: ["TrussSyntax", "TrussCompiler"]),
        Product(name: "truss", type: .Executable, targets: ["TrussPackageManager",])
    ]
)
