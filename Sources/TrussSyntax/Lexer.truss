public final class Lexer {
    private var input: CharStream
    public init(input: CharStream) {
        self.input = input
    }
    public func parse() -> [Token] {
        var tokens: [Token] = []
        while !self.input.isEmpty {
            if let token = self.parse_a_token() {
                tokens.append(token)
            }
        }
        tokens
    }
    private func parse_a_token() -> Token? {
        self.skipWhitechars()
        guard let c = self.input.peek else {
            return null
        }
        if c == '"' {
            self.parseStringLiteral()
        } else if c == '\'' {
            self.parseCharLiteral()
        } else if c.isAsciiDigit {
            self.parseNumber()
        } else if c == '(' {
            let position = self.input.currentPosition
            self.input.incrementPosition()
            Token(value: "(", kind: .Separator(.OpenParen), pos: position, id: self.input.id)
        } else if c == ')' {
            let position = self.input.currentPosition
            self.input.incrementPosition()
            Token(value: ")", kind: .Separator(.CloseParen), pos: position, id: self.input.id)
        } else if c == '[' {
            let position = self.input.currentPosition
            self.input.incrementPosition()
            Token(value: "[", kind: .Separator(.OpenBracket), pos: position, id: self.input.id)
        } else if c == ']' {
            let position = self.input.currentPosition
            self.input.incrementPosition()
            Token(value: "]", kind: .Separator(.CloseBracket), pos: position, id: self.input.id)
        } else if c == '{' {
            let position = self.input.currentPosition
            self.input.incrementPosition()
            Token(value: "{", kind: .Separator(.OpenBrace), pos: position, id: self.input.id)
        } else if c == '}' {
            let position = self.input.currentPosition
            self.input.incrementPosition()
            Token(value: "}", kind: .Separator(.CloseBrace), pos: position, id: self.input.id)
        } else if c == ';' {
            let position = self.input.currentPosition
            self.input.incrementPosition()
            Token(value: ";", kind: .Separator(.SemiColon), pos: position, id: self.input.id)
        } else if c == ',' {
            let position = self.input.currentPosition
            self.input.incrementPosition()
            Token(value: ",", kind: .Separator(.Comma), pos: position, id: self.input.id)
        } else if c == '@' {
            let position = self.input.currentPosition
            self.input.incrementPosition()
            Token(value: "@", kind: .Separator(.At), pos: position, id: self.input.id)
        } else if c == '$' {
            let position = self.input.currentPosition
            self.input.incrementPosition()
            Token(value: "$", kind: .Operator(.Dollar), pos: position, id: self.input.id)
        } else if c == '~' {
            let position = self.input.currentPosition
            self.input.incrementPosition()
            Token(value: "~", kind: .Operator(.BitNot), pos: position, id: self.input.id)
        } else {
            panic()
        }
    }
    private func parseStringLiteral() -> Token {
        panic()
    }
    private func parseCharLiteral() -> Token {
        panic()
    }
    private func parseNumber() -> Token {
        panic()
    }
    private func skipWhitechars() {
        var c2 = self.input.peek!
        while !self.input.isEmpty {
            guard let c = self.input.peek && c.isWhiteSpace else {
                break
            }
            self.input.pos += 1
            if c == '\n' {
                self.input.line += 1
                self.input.col = 0
            } else {
                self.input.col += 1
            }
            c2 = self.input.peek!
        }
    }
}
